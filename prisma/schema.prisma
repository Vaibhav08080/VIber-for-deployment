generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Project {
  id String @id @default(uuid())
  name String
  userId String
  githubRepo String?
  githubUrl String?
  supabaseUrl String?
  supabaseAnonKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  progressSteps ProgressStep[]

}


enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType{
  RESULT
  ERROR
}

enum MessageMode {
  BUILD
  DISCUSS
}

model Message{
  id String @id @default(uuid())
  content String
  imageUrl String?
  role MessageRole
  type MessageType
  mode MessageMode @default(BUILD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project Project @relation(fields: [projectId], references: [id] , onDelete: Cascade)

  fragment Fragment?

}

model Fragment{
  id String @id @default(uuid())
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id] , onDelete: Cascade)



  sandboxUrl String
  title String
  files Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


}

enum StepStatus {
  RUNNING
  DONE
  ERROR
}

model ProgressStep {
  id        String     @id @default(uuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  step      String
  status    StepStatus @default(RUNNING)
  createdAt DateTime   @default(now())

  @@index([projectId, createdAt])
}

model Usage{
  key String @id
  points Int
  expire DateTime?
}